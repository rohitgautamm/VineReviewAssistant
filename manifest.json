{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "VinePilot AI — Smart Vine Review & Phone Photo Studio",
  "short_name": "VinePilot AI",
  "description": "Write authentic, human-sounding Amazon Vine reviews in your own tone with 100% Community Guideline protection, bulk photo prefill, and instant QR phone-to-laptop photo upload.",
  "version": "1.0.0",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "tabs",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.de/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.es/*",
    "*://*.amazon.it/*",
    "*://*.amazon.co.jp/*",
    "*://*.amazon.com.au/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VinePilot AI — Open Review Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "studio.html?mode=sidepanel"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.in/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.es/*",
        "https://*.amazon.it/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.com.au/*"
      ],
      "js": [
        "js/guidelines-engine.js",
        "js/amazon-review-prefill.js",
        "js/vine-page-inject.js"
      ],
      "css": [
        "css/vine-inject.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "studio.html",
        "studio.css",
        "studio.js",
        "js/*.js",
        "images/*.png"
      ],
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.in/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.es/*",
        "https://*.amazon.it/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.com.au/*"
      ]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
